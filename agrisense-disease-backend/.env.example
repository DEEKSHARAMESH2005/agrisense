# Application Configuration
APP_NAME=AgriSense Disease Detection API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Hugging Face AI Model Configuration
MODEL_ID=neghani/plantvillage-mobilenetv2
# Options: auto (uses CUDA if available, else CPU), cpu, cuda
MODEL_DEVICE=auto

# Uncertainty Flagging Threshold in Percentage (0-100)
# Predictions with confidence below this threshold are marked as uncertain.
CONFIDENCE_THRESHOLD=50.0

# Database Configuration (SQLite for local dev, PostgreSQL for production)
# SQLite: sqlite:///./agrisense.db
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/agrisense_db
DATABASE_URL=sqlite:///./agrisense.db

# File Upload Security Settings
MAX_UPLOAD_SIZE_MB=10
SAVE_UPLOADED_IMAGES=False
UPLOAD_DIR=./uploads

# CORS Allowed Origins (Comma-separated list or * for all)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://127.0.0.1:8081

# Suppress Hugging Face Windows Symlink Warning
HF_HUB_DISABLE_SYMLINKS_WARNING=1
